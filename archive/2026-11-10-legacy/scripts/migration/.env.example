# Migration runtime configuration
CONTENT_SOURCE_MODE=d1r2

# Cloudflare D1
D1_DATABASE_ID=
D1_API_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=blog-assets
R2_PUBLIC_URL=https://your-account.r2.dev

# Dual-run / rollback
DUAL_RUN_ENABLED=0
ROLLBACK_WINDOW_MINUTES=1

# Migration metadata
MIGRATION_BUCKET_PREFIX=blog
MIGRATION_DB_PREFIX=d1
