# Canonical public origin. Set in both Vercel Preview and Production.
SITE_URL=https://hozorica.com
# Keep false until the first real article is ready. Preview always stays noindex.
SITE_INDEXABLE=false

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
CLOUDFLARE_ACCOUNT_ID=4cf494c21da0e5276ddd5eabeb310aaa
CLOUDFLARE_D1_DATABASE_ID=1a801df7-75e9-46d2-998b-4b4d6f5811e2
# Cloudflare API token scoped to this account, Account > D1 > Edit.
CLOUDFLARE_D1_API_TOKEN=
# At least 32 random characters. Keep stable across deployments.
ENGAGEMENT_SECRET=
# Vercel is detected automatically. For other hosts, set ONLY a header
# overwritten by your trusted ingress (never a client-controlled header).
ENGAGEMENT_IP_HEADER=
# Optional local-only preview with Node 24+, no remote credentials needed:
# ENGAGEMENT_STORAGE=sqlite
