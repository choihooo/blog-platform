{
  "name": "@blog-platform/editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format:check": "prettier \"src/**/*.{ts,tsx}\" package.json tsconfig.json --check",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "parse5": "^8.0.1"
  }
}
