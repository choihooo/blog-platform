    "prebuild": "pnpm build:ledger-demo",
    "build:ledger-demo": "node scripts/build-ledger-demo.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "radix-ui": "1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "3.7.0",
