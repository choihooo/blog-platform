{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hozorica-portfolio-rag",
  "account_id": "4cf494c21da0e5276ddd5eabeb310aaa",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-platform",
      "database_id": "48a97611-3d61-4ceb-9841-d3f91f360446",
      "remote": true,
    },
  ],
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [
    { "binding": "INDEX", "index_name": "hozorica-portfolio-rag", "remote": true },
    { "binding": "INDEX_GEMINI", "index_name": "hozorica-rag-gemini-001-768-v1", "remote": true },
  ],
  "ratelimits": [
    { "name": "SEARCH_LIMIT", "namespace_id": "9020601", "simple": { "limit": 30, "period": 60 } },
  ],
}
