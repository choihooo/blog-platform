    "permanent": true,
    "source": "/rss.xml",
  },
  {
    "destination": "/blog/:slug",
    "permanent": true,
    "source": "/posts/:slug",
  },
  {
    "destination": "/blog/search?q=:q",
    "has": [
      {
        "key": "q",
        "type": "query",
        "value": "(?<q>.+)",
      },
    ],
    "permanent": false,
    "source": "/blog",
  },
  {
    "destination": "/blog/page/:page",
    "has": [
      {
        "key": "page",
        "type": "query",
        "value": "(?<page>[0-9]+)",
      },
    ],
    "permanent": true,
    "source": "/blog",
  },
  {
    "destination": "/blog/categories/:path*",
    "permanent": true,
    "source": "/categories/:path*",
  },
  {
    "destination": "/blog/tags",
    "permanent": true,
    "source": "/tags",
  },
  {
    "destination": "/blog/tags/:slug",
    "permanent": true,
    "source": "/tags/:slug",
  },
  {
    "destination": "/blog/tags/:slug/page/:page",
    "permanent": true,
    "source": "/tags/:slug/page/:page",
  },
  {
    "destination": "/blog/rss.xml",
    "permanent": true,
    "source": "/rss.xml",
  },
]
`;
