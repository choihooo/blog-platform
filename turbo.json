{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET",
    "AUTH_SECRET",
    "ANALYTICS_PROVIDER",
    "BLOG_DEPLOY_HOOK_URL",
    "BLOG_CONTENT_PROXY_URL",
    "BLOG_CONTENT_PROXY_PATH",
    "BLOG_REVALIDATE_SECRET",
    "BLOG_REVALIDATE_URL",
    "CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_D1_API_TOKEN",
    "CLOUDFLARE_D1_DATABASE_ID",
    "CONTENT_SOURCE_MODE",
    "D1_DATABASE_ID",
    "GITHUB_APP_PRIVATE_KEY",
    "GA4_PROPERTY_ID",
    "GOOGLE_SERVICE_ACCOUNT_JSON",
    "NEXTAUTH_URL",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID",
    "NEXT_PUBLIC_SITE_URL",
    "PREVIEW_TOKEN_SECRET",
    "RAG_API_URL",
    "RAG_SEARCH_TOKEN",
    "RAG_ADMIN_TOKEN",
    "NEXT_PUBLIC_KANANA_MODEL_URL",
    "SEARCH_CONSOLE_PROPERTY",
    "VERCEL_DEPLOY_HOOK_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format:check": {
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
